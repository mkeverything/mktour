# the postgres from compose.yaml; `bun db:up` starts it and migrates both databases
DATABASE_URL=postgresql://mktour:mktour@127.0.0.1:5433/mktour
TEST_DATABASE_URL=postgresql://mktour:mktour@127.0.0.1:5433/mktour_test

# lichess oauth uses pkce without registration, so any id works
LICHESS_CLIENT_ID=mktour-local

# optional: the contact form, cron routes and analytics
NEXT_PUBLIC_CONTACT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRON_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_API_HOST=
NEXT_PUBLIC_POSTHOG_UI_HOST=
