{
  "name": "mktour",
  "version": "0.9.0",
  "private": true,
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "bunx next dev",
    "dev:test": "MKTOURTEST=true bunx next dev",
    "dev:local": "OFFLINE=true bunx next dev",
    "build": "next build",
    "start": "bunx --bun next start",
    "lint": "bunx eslint .",
    "opt": "OPT=true bunx --bun next dev",
    "analyze": "ANALYZE=true next build",
    "format": "bunx --bun prettier . --write",
    "db:push": "drizzle-kit generate && bun run src/server/db/migrate.ts",
    "db:drop": "drizzle-kit drop",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "localdb:push": "OFFLINE=true drizzle-kit generate && OFFLINE=true bun run src/server/db/migrate.ts",
    "localdb:drop": "OFFLINE=true drizzle-kit drop",
    "localdb:studio": "OFFLINE=true drizzle-kit studio",
    "localdb:check": "OFFLINE=true drizzle-kit check",
    "knip": "knip-bun --use-tsconfig-files",
    "generate-erd": "bun run src/lib/generate-erd.ts",
    "prepare": "husky",
    "generate-openapi": "bun run src/server/api/generateOpenApi.ts > src/app/api/spec/openapi-spec.json",
    "test:noseed": "SKIP_SEED=1 bun test",
    "check": "bunx tsc --noEmit && bun lint && bun test"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@hookform/resolvers": "^5.7.1",
    "@libsql/client": "^0.17.4",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@next/bundle-analyzer": "^16.3.0",
    "@next/env": "^16.3.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@scalar/nextjs-api-reference": "^0.9.26",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "arctic": "^3.7.0",
    "autoprefixer": "^10.5.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "caniuse-lite": "^1.0.30001806",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-seed": "^0.3.1",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.0.0",
    "graphology": "^0.26.0",
    "loglayer": "^9.4.0",
    "lucia": "^3.2.2",
    "lucide-react": "^1.28.0",
    "nanoid": "^5.1.16",
    "next": "^16.3.0",
    "next-intl": "^4.13.5",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "postcss": "8.5.8",
    "posthog-js": "^1.413.1",
    "posthog-node": "^5.47.11",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.84.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-responsive": "^10.0.1",
    "react-scan": "^0.5.7",
    "react-type-animation": "^3.2.0",
    "react-use-websocket": "^4.13.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "trpc-client-devtools-link": "^0.1.1",
    "trpc-to-openapi": "^3.3.0",
    "trpc-ui": "^1.0.15",
    "typescript-eslint": "^8.66.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@faker-js/faker": "^10.5.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/bun": "^1.3.14",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yargs": "^17.0.35",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "next-compose-plugins": "^2.2.1",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "ts-graphviz": "^3.0.7",
    "tsx": "4.23.8",
    "typescript": "^5.9.3",
    "yargs": "^18.1.0"
  },
  "vsc-organize-imports": {
    "orderSpecifiers": true,
    "orderSpecifiersAsSingleLine": true,
    "baseUrl": "src",
    "emptyLinesAfterImports": 1
  },
  "eslintIgnore": [
    "src/components/ui/**/*.ts",
    "src/components/ui/**/*.tsx",
    "src/types/**/*.ts"
  ],
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "@vercel/speed-insights",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "trpc-to-openapi@3.3.0": "patches/trpc-to-openapi@3.3.0.patch"
  }
}
