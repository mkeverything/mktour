{
  "name": "mktour",
  "version": "0.9.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun db:up && bun run --bun next dev",
    "dev:test": "bun db:test && MKTOURTEST=true bun run --bun next dev",
    "build": "bun run --bun next build",
    "start": "bun run --bun next start",
    "lint": "bun run --bun eslint src/",
    "doctor": "react-doctor --no-score --blocking warning",
    "opt": "bun db:up && OPT=true bun run --bun next dev",
    "analyze": "ANALYZE=true bun run --bun next build",
    "format": "bun run --bun prettier . --write",
    "db:up": "docker compose up --detach --wait postgres && drizzle-kit migrate",
    "db:test": "docker compose up --detach --wait postgres-test && MKTOURTEST=true drizzle-kit migrate",
    "db:reset": "docker compose down --volumes && bun db:up",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "knip": "knip-bun --use-tsconfig-files",
    "generate-erd": "bun run src/lib/generate-erd.ts",
    "prepare": "husky",
    "generate-openapi": "bun run --conditions=react-server src/server/api/generateOpenApi.ts > src/app/api/spec/openapi-spec.json",
    "test": "bun db:test && bun test",
    "test:noseed": "SKIP_SEED=1 bun test",
    "check": "bun run --bun tsc --noEmit && bun run --bun lint && bun run doctor && bun run test"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@hookform/resolvers": "^6.0.2",
    "@next/bundle-analyzer": "^16.4.5",
    "@next/env": "^16.4.5",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@scalar/nextjs-api-reference": "^0.12.16",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.25.2",
    "@trpc/react-query": "^11.25.2",
    "@trpc/server": "^11.25.2",
    "@trpc/tanstack-react-query": "^11.25.2",
    "@upstash/redis": "^1.41.0",
    "arctic": "^3.7.0",
    "autoprefixer": "^10.6.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "caniuse-lite": "^1.0.30001823",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^14.10.1",
    "graphology": "^0.26.0",
    "isbot": "^5.2.2",
    "loglayer": "^9.4.0",
    "lucia": "^3.2.2",
    "lucide-react": "^1.70.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.5",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "posthog-js": "^1.447.3",
    "posthog-node": "^5.63.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-type-animation": "^3.2.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "trpc-client-devtools-link": "^0.1.1",
