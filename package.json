    "@faker-js/faker": "^10.6.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@types/bun": "^1.4.4",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yargs": "^17.0.35",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "next-compose-plugins": "^2.2.1",
    "react-doctor": "0.9.18",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "ts-graphviz": "^3.0.13",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "yargs": "^18.2.0"
  },
  "vsc-organize-imports": {
    "orderSpecifiers": true,
    "orderSpecifiersAsSingleLine": true,
    "baseUrl": "src",
    "emptyLinesAfterImports": 1
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "trpc-to-openapi@3.3.3": "patches/trpc-to-openapi@3.3.3.patch"
  }
}
