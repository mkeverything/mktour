{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": ["src/components/ui/**"],
    "overrides": [
      {
        "files": ["src/lib/pairing-generators/**"],
        "rules": ["react-doctor/js-set-map-lookups"],
      },
      {
        "files": ["src/lib/pairing-generators/**"],
        "rules": ["react-doctor/js-index-maps"],
      },
      // mutations query inside transactions, whose one connection runs a query at a time
      {
        "files": ["src/server/mutations/**"],
        "rules": [
          "react-doctor/server-sequential-independent-await",
          "react-doctor/async-parallel",
        ],
      },
    ],
  },
}
